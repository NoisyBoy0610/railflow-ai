# RailFlow AI - Production Environment Variables Template
# Copy this file to .env.local and add your API keys (optional, automatic fallback is enabled)

# AI Models (Gemini / OpenAI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Live Indian Railways APIs (Optional: for live NTES / RapidAPI PNR status)
RAPIDAPI_IRCTC_KEY=""
NTES_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
